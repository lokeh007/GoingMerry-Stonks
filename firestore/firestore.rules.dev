rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Screener results: PUBLIC READ, SERVICE ACCOUNT WRITE
    // Allow reading both the screener documents and querying the runs collection
    match /screeners/{screener} {
      // Allow reading screener metadata
      allow read: if true;

      // Allow reading/querying individual run documents
      match /runs/{date} {
        // Allow anyone to read cached screener results
        allow read: if true;

        // Only allow write access from the backend service account
        // Used by: Backend API (Cloud Run service) + Batch Screeners (Cloud Run jobs)
        // Environment: DEVELOPMENT
        // Project: [UPDATE WITH DEV PROJECT ID]
        // Service Account: [UPDATE WITH DEV SERVICE ACCOUNT EMAIL]
        //
        // NOTE: For local development, you may want to relax this rule:
        // allow write: if request.auth != null;
        allow write: if request.auth != null &&
                     request.auth.token.email == 'dev-backend-sa@[DEV_PROJECT_ID].iam.gserviceaccount.com';
      }
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
