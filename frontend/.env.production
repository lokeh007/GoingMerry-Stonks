# Production Environment Variables for React Frontend
# These values are baked into the build at compile time

# API endpoint - Use absolute URL to Cloud Run backend
# This works for both Firebase Hosting and Load Balancer deployments
REACT_APP_API_URL=https://prod-backend-api-591098440727.us-east5.run.app/api

# Environment
NODE_ENV=production
GENERATE_SOURCEMAP=false

# Build optimizations
INLINE_RUNTIME_CHUNK=false
IMAGE_INLINE_SIZE_LIMIT=0
