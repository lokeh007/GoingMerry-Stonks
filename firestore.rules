rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Screener results: PUBLIC READ, SERVICE ACCOUNT WRITE
    // Allow reading both the screener documents and querying the runs collection
    match /screeners/{screener} {
      // Allow reading screener metadata
      allow read: if true;

      // Allow reading/querying individual run documents
      match /runs/{date} {
        // Allow anyone to read cached screener results
        allow read: if true;

        // Only allow Cloud Run Job service account to write
        // (authenticated requests from backend service account)
        allow write: if request.auth != null;
      }
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
